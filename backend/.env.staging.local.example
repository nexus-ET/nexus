# Copy to E:\NEXUS-staging\backend\.env for staging-local (branch staging)
# Ports: backend 8003, frontend 5176 — use a separate Neon staging database.

PROJECT_NAME="NEXUS"
API_V1_STR="/api/v1"
DATABASE_URL="postgresql+psycopg://USER:PASSWORD@HOST/neondb?sslmode=require"
SECRET_KEY="change-me"
ACCESS_TOKEN_EXPIRE_MINUTES=60

PROVIDER=WHATSAPP
WEBHOOK_VERIFY_TOKEN=your-meta-webhook-verify-token
WHATSAPP_VERIFY_TOKEN=your-meta-webhook-verify-token
WHATSAPP_ACCESS_TOKEN=

# Meta test line (reference only — not active when ENVIRONMENT=staging)
WHATSAPP_TEST_PHONE_NUMBER=+15556656397
WHATSAPP_TEST_PHONE_NUMBER_ID=1176133525584040
WHATSAPP_TEST_WABA_ID=1985156525441903

# Edutrust business line — active on staging / nexus-dev
WHATSAPP_BUSINESS_PHONE_NUMBER=+917411952525
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=1097416893464116
WHATSAPP_BUSINESS_WABA_ID=1312656237246811

NEXUS_TUNNEL_ENABLED=false
PUBLIC_TUNNEL_BASE=https://nexus-dev.edutrust.in

NEXUS_INSTANCE=nexus-dev
ENVIRONMENT=staging
NEXUS_WHATSAPP_AUTO_SYNC=true

NEXUS_PORT=8003
NEXUS_FRONTEND_PORT=5176
NEXUS_BIND_HOST=127.0.0.1
FRONTEND_URL=http://127.0.0.1:5176
