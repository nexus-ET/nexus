# Hostinger VPS staging template — copy values into:
#   /var/www/nexus/backend/.env
# DO NOT commit the real .env. DO NOT overwrite local development .env.
#
# Staging database: Hostinger KVM 1 PostgreSQL (NOT Neon).
#   Database: nexus_edutrust
#   User:     nexus_et_admin (full privileges)
# Setup guide: deploy/setup_staging_db.md

PROJECT_NAME=NEXUS
API_V1_STR=/api/v1

# --- REQUIRED: Hostinger KVM 1 Postgres (co-located on VPS) ---
# Fill YOUR_PASSWORD and YOUR_DB_HOST on the VPS only (127.0.0.1 if Postgres is local):
#   postgresql+psycopg://nexus_et_admin:YOUR_PASSWORD@127.0.0.1:5432/nexus_edutrust
# Optional for local Postgres: ?sslmode=disable
# Do NOT use develop Neon (still-paper) or old staging Neon (Nexus-Dev-1 / sparkling-violet).
DATABASE_URL=postgresql+psycopg://nexus_et_admin:YOUR_PASSWORD@YOUR_DB_HOST:5432/nexus_edutrust

SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Public staging site
FRONTEND_URL=https://nexus-dev.edutrust.in
PUBLIC_TUNNEL_BASE=https://nexus-dev.edutrust.in
NEXUS_INSTANCE=nexus-dev
ENVIRONMENT=staging
NEXUS_WHATSAPP_AUTO_SYNC=true
NEXUS_TUNNEL_ENABLED=false
NEXUS_PORT=8002
NEXUS_BIND_HOST=127.0.0.1

# IntelX regulatory scrapers — browser fallback uses Playwright chrome-headless-shell.
# Staging is Linux (no Windows Firewall dialog). Ensure deploy runs:
#   python -m playwright install chromium
# INTEL_SCRAPER_BROWSER_FALLBACK=true
# INTEL_SCRAPER_ALLOW_INSECURE_SSL=true

# WhatsApp intake: welcome template only; student hi/hello starts questions
NEXUS_APPOINTMENTS_ONLY=true
PROVIDER=WHATSAPP
WEBHOOK_VERIFY_TOKEN=your-meta-webhook-verify-token
WHATSAPP_VERIFY_TOKEN=your-meta-webhook-verify-token
WHATSAPP_ACCESS_TOKEN=

# Business line (active when NEXUS_INSTANCE=nexus-dev / staging)
WHATSAPP_BUSINESS_PHONE_NUMBER=+917411952525
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=1097416893464116
WHATSAPP_BUSINESS_WABA_ID=1312656237246811

# Meta test line (reference only — unused when NEXUS_INSTANCE is staging)
WHATSAPP_TEST_PHONE_NUMBER=+15556656397
WHATSAPP_TEST_PHONE_NUMBER_ID=1176133525584040
WHATSAPP_TEST_WABA_ID=1985156525441903

WHATSAPP_OUTREACH_TEMPLATE=et_student_welcome
WHATSAPP_OUTREACH_TEMPLATE_LANGUAGE=en
WHATSAPP_OUTREACH_TEMPLATE_PARAMETERS=student,company
WHATSAPP_OUTREACH_TEMPLATE_PARAMETER_FORMAT=positional
WHATSAPP_OUTREACH_TEMPLATE_PARAMETER_NAMES=student_name,company_name
WHATSAPP_OUTREACH_COMPANY_NAME=Edutrust
WHATSAPP_OUTREACH_DELIVERY_WAIT_SECONDS=15
WHATSAPP_OUTREACH_SKIP_INTAKE_FOLLOWUP=true
# Staff booking confirmations outside the 24h window (register via scripts/register_whatsapp_booking_templates.py)
# Templates must be APPROVED in Meta before delivery outside the 24h session window.
WHATSAPP_BOOKING_TEMPLATE=et_booking_confirmation
WHATSAPP_BOOKING_TEMPLATE_LANGUAGE=en
WHATSAPP_ADMIN_BOOKING_TEMPLATE=et_booking_assigned
WHATSAPP_ADMIN_BOOKING_TEMPLATE_LANGUAGE=en

# Post-deploy API smoke (hostinger-staging.sh → staging_post_deploy_smoke.py)
# Use a real staging admin; never commit the password.
STAGING_SMOKE_EMAIL=ishq@edutrust.in
STAGING_SMOKE_PASSWORD=
# STAGING_SMOKE_PHONE=+91…

# Outbound mail display name (optional — app default is Nexus Counselling)
# SMTP_FROM_NAME=Nexus Counselling

META_PAGE_ID=
META_GRAPH_ACCESS_TOKEN=

# Optional: Cloudflare R2 for Academia Hub assets
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
R2_ENDPOINT_URL=

# Reduce staging noise from security audit WhatsApp blasts
SECURITY_AUDIT_ALERT_WHATSAPP_ENABLED=false
SECURITY_AUDIT_ALERT_MANUAL_ONLY=true

# Fresh-DB login — all 3 Super Admins are seeded (shared password unless you --copy-from)
#   ishq@edutrust.in, arunpk@edutrust.in, admin@edutrust.in
STAGING_ADMIN_PASSWORD=StagingAdmin!ChangeMe
# Optional: copy users+roles from develop Neon still-paper (keeps each user's real password)
# STAGING_USERS_SOURCE_URL=postgresql+psycopg://...@ep-still-paper-...pooler.../neondb?sslmode=require
