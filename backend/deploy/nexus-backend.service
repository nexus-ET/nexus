[Unit]
Description=NEXUS FastAPI backend
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/nexus/backend
# Prefer dotenv wrapper over EnvironmentFile=: Neon URLs with &channel_binding,
# quoted values, or CRLF from Windows editors can break systemd's env parser
# while `python scripts/...` (dotenv) still works — classic "seed OK, service 502".
ExecStart=/var/www/nexus/backend/deploy/run-nexus-backend.sh
Restart=always
RestartSec=5
# Bootstrap (create_all / sync_schema) can take a while on cold Neon.
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
