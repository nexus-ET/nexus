[Unit]
Description=NEXUS FastAPI backend
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/nexus/backend
EnvironmentFile=/var/www/nexus/backend/.env
ExecStart=/var/www/nexus/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8002
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
