# Copy to backend/.env on the VPS (never commit the real file):
#   cp backend/deploy/env.production.example backend/.env
#   nano backend/.env

ENVIRONMENT=production
PROJECT_NAME=NEXUS
API_V1_STR=/api/v1

# Neon / Postgres
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require

SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Public site (same host serves UI + API via nginx)
FRONTEND_URL=https://nexus.YOUR_DOMAIN.com
PUBLIC_TUNNEL_BASE=https://nexus.YOUR_DOMAIN.com

NEXUS_INSTANCE=production
ENVIRONMENT=production
NEXUS_WHATSAPP_AUTO_SYNC=true

NEXUS_PORT=8002
NEXUS_BIND_HOST=127.0.0.1
NEXUS_TUNNEL_ENABLED=false

PROVIDER=WHATSAPP
WEBHOOK_VERIFY_TOKEN=your-meta-webhook-verify-token
WHATSAPP_VERIFY_TOKEN=your-meta-webhook-verify-token
WHATSAPP_ACCESS_TOKEN=
# Meta test line (local development)
WHATSAPP_TEST_PHONE_NUMBER=+15556656397
WHATSAPP_TEST_PHONE_NUMBER_ID=1176133525584040
WHATSAPP_TEST_WABA_ID=1985156525441903
# Edutrust business line (staging / production)
WHATSAPP_BUSINESS_PHONE_NUMBER=+917411952525
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=1097416893464116
WHATSAPP_BUSINESS_WABA_ID=1312656237246811
WHATSAPP_OUTREACH_TEMPLATE=hello_world

# No LLM/API keys: fixed intake scripts + appointment booking only on AI Active
NEXUS_APPOINTMENTS_ONLY=true

META_PAGE_ID=
META_GRAPH_ACCESS_TOKEN=

OPENAI_API_KEY=
