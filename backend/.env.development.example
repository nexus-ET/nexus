# Copy to backend/.env for local DEV (E:\NEXUS, branch develop)
# Ports: backend 8002, frontend 5175
# Database bootstrap: backend/deploy/setup_dev_db.md

PROJECT_NAME="NEXUS"
API_V1_STR="/api/v1"
# Hostinger KVM 1 dev Postgres (replace YOUR_* — do not use staging nexus_edutrust)
DATABASE_URL="postgresql+psycopg://nexus_dev_admin:YOUR_PASSWORD@YOUR_DB_HOST:5432/nexus_dev"
# Optional: fail hung queries after N ms (useful over SSH tunnel; 0 = server default)
# PG_STATEMENT_TIMEOUT_MS=60000
# Optional legacy Neon still-paper source for one-time copy scripts — see .env.dev-source.example
# LEGACY_DEV_SOURCE_URL="postgresql+psycopg://neondb_owner:...@ep-still-paper-...-pooler.../neondb?sslmode=require"
SECRET_KEY="change-me"
ACCESS_TOKEN_EXPIRE_MINUTES=60

PROVIDER=WHATSAPP
WEBHOOK_VERIFY_TOKEN=your-meta-webhook-verify-token
WHATSAPP_VERIFY_TOKEN=your-meta-webhook-verify-token
WHATSAPP_ACCESS_TOKEN=

# Meta test line — used automatically when NEXUS_INSTANCE=development
WHATSAPP_TEST_PHONE_NUMBER=+15556656397
WHATSAPP_TEST_PHONE_NUMBER_ID=1176133525584040
WHATSAPP_TEST_WABA_ID=1985156525441903

# Edutrust business line — used on staging; also the webhook handoff target on dev stop
WHATSAPP_BUSINESS_PHONE_NUMBER=+917411952525
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=1097416893464116
WHATSAPP_BUSINESS_WABA_ID=1312656237246811

# Opens Meta 24h window before business-initiated outreach (combined welcome + intake prompt in Meta).
WHATSAPP_OUTREACH_TEMPLATE=et_student_welcome
# Must match Meta template language: English = en, English (US) = en_US
WHATSAPP_OUTREACH_TEMPLATE_LANGUAGE=en
WHATSAPP_OUTREACH_TEMPLATE_PARAMETERS=student,company
WHATSAPP_OUTREACH_TEMPLATE_PARAMETER_FORMAT=positional
WHATSAPP_OUTREACH_TEMPLATE_PARAMETER_NAMES=student_name,company_name
WHATSAPP_OUTREACH_COMPANY_NAME=Edutrust
WHATSAPP_OUTREACH_DELIVERY_WAIT_SECONDS=3
WHATSAPP_OUTREACH_FOLLOWUP_DELAY_SECONDS=8
# Welcome template body includes the full-name intake line — no second WhatsApp send.
WHATSAPP_OUTREACH_SKIP_INTAKE_FOLLOWUP=true
# Staff booking confirmations (UTILITY) — required when the 24h WhatsApp window is closed.
# Register with: python scripts/register_whatsapp_booking_templates.py
WHATSAPP_BOOKING_TEMPLATE=et_booking_confirmation
WHATSAPP_BOOKING_TEMPLATE_LANGUAGE=en
WHATSAPP_ADMIN_BOOKING_TEMPLATE=et_booking_assigned
WHATSAPP_ADMIN_BOOKING_TEMPLATE_LANGUAGE=en

NEXUS_TUNNEL_MODE=quick
NEXUS_TUNNEL_ENABLED=true
# Force IPv4 to Cloudflare edge if quick tunnel logs "control stream encountered a failure" (Windows).
# NEXUS_TUNNEL_EDGE_IP_VERSION=4
PUBLIC_TUNNEL_BASE=

# Environment identity (development → test number; staging/nexus-dev → business number)
NEXUS_INSTANCE=development
ENVIRONMENT=development
NEXUS_APPOINTMENTS_ONLY=true
NEXUS_WHATSAPP_AUTO_SYNC=true
NEXUS_WHATSAPP_HANDOFF_URL=https://nexus-dev.edutrust.in

NEXUS_PORT=8002
NEXUS_FRONTEND_PORT=5175
NEXUS_BIND_HOST=127.0.0.1

# IntelX scrapers: keep true for Cloudflare/JS sites; Chromium is constrained to
# 127.0.0.1. Set false if you want to skip Playwright and avoid Windows Firewall prompts.
# INTEL_SCRAPER_BROWSER_FALLBACK=true
FRONTEND_URL=http://127.0.0.1:5175

# Nexus Intel AI Assistant (local Ollama)
INTEL_AI_MODEL=ollama:llama3.1
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
INTEL_AI_TIMEOUT_SECONDS=300
INTEL_AI_CONTEXT_CHARS=10000
INTEL_AI_OLLAMA_KEEP_ALIVE=-1
# Note: send keep_alive as integer -1 (forever). String "-1" is rejected by Ollama.
INTEL_AI_OLLAMA_NUM_PREDICT=1024
INTEL_AI_OLLAMA_NUM_CTX=8192
INTEL_AI_OLLAMA_TEMPERATURE=0.1
INTEL_AI_OLLAMA_TOP_P=0.9
INTEL_AI_HISTORY_TURNS=3
INTEL_AI_GLOSSARY_TOP_K=12
INTEL_AI_ACADEMIA_TOP_K=18
# Optional OS-level: keep models permanently loaded (OLLAMA_KEEP_ALIVE=-1)
