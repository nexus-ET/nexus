# Copy to backend/.env for local DEV (E:\NEXUS, branch develop)
# Ports: backend 8002, frontend 5175
# Database bootstrap: backend/deploy/setup_dev_db.md

PROJECT_NAME="NEXUS"
API_V1_STR="/api/v1"
# Hostinger KVM 1 Postgres — prefer SSH tunnel from Windows:
#   powershell -ExecutionPolicy Bypass -File E:\NEXUS\start-dev.ps1
# DATABASE_URL="postgresql+psycopg://nexus_dev_et_admin:YOUR_PASSWORD@127.0.0.1:15432/nexus_edutrust_dev"
# Direct host (no tunnel) — replace YOUR_* — do not use staging nexus_edutrust:
DATABASE_URL="postgresql+psycopg://nexus_dev_admin:YOUR_PASSWORD@YOUR_DB_HOST:5432/nexus_dev"
# Optional: fail hung queries after N ms (useful over SSH tunnel; 0 = server default)
# PG_STATEMENT_TIMEOUT_MS=60000
# Optional SSH tunnel overrides (defaults match start-dev.ps1):
# NEXUS_SSH_HOST=187.127.186.63
# NEXUS_SSH_USER=root
# NEXUS_SSH_LOCAL_PORT=15432
# NEXUS_SSH_IDENTITY_FILE=%USERPROFILE%\.ssh\nexus_vps
# Optional legacy Neon still-paper source for one-time copy scripts — see .env.dev-source.example
# LEGACY_DEV_SOURCE_URL="postgresql+psycopg://neondb_owner:...@ep-still-paper-...-pooler.../neondb?sslmode=require"
SECRET_KEY="change-me"
ACCESS_TOKEN_EXPIRE_MINUTES=60

PROVIDER=WHATSAPP
# Must match nexus-dev WEBHOOK_VERIFY_TOKEN when NEXUS_WHATSAPP_AUTO_SYNC=true
# (Meta hands the webhook back to staging on local stop using this token).
WEBHOOK_VERIFY_TOKEN=your-meta-webhook-verify-token
WHATSAPP_VERIFY_TOKEN=your-meta-webhook-verify-token
WHATSAPP_ACCESS_TOKEN=

# Meta test line — used automatically when NEXUS_INSTANCE=development
WHATSAPP_TEST_PHONE_NUMBER=+15556656397
WHATSAPP_TEST_PHONE_NUMBER_ID=1176133525584040
WHATSAPP_TEST_WABA_ID=1985156525441903

# Edutrust business line — used on staging; also the webhook handoff target on dev stop
WHATSAPP_BUSINESS_PHONE_NUMBER=+917411952525
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=1097416893464116
WHATSAPP_BUSINESS_WABA_ID=1312656237246811

# Opens Meta 24h window before business-initiated outreach (combined welcome + intake prompt in Meta).
WHATSAPP_OUTREACH_TEMPLATE=et_student_welcome
# Must match Meta template language: English = en, English (US) = en_US
WHATSAPP_OUTREACH_TEMPLATE_LANGUAGE=en
WHATSAPP_OUTREACH_TEMPLATE_PARAMETERS=student,company
WHATSAPP_OUTREACH_TEMPLATE_PARAMETER_FORMAT=positional
WHATSAPP_OUTREACH_TEMPLATE_PARAMETER_NAMES=student_name,company_name
WHATSAPP_OUTREACH_COMPANY_NAME=Edutrust
WHATSAPP_OUTREACH_DELIVERY_WAIT_SECONDS=3
WHATSAPP_OUTREACH_FOLLOWUP_DELAY_SECONDS=8
# Welcome template body includes the full-name intake line — no second WhatsApp send.
WHATSAPP_OUTREACH_SKIP_INTAKE_FOLLOWUP=true
# Staff booking confirmations (UTILITY) — required when the 24h WhatsApp window is closed.
# Register with: python scripts/register_whatsapp_booking_templates.py
WHATSAPP_BOOKING_TEMPLATE=et_booking_confirmation
WHATSAPP_BOOKING_TEMPLATE_LANGUAGE=en
WHATSAPP_ADMIN_BOOKING_TEMPLATE=et_booking_assigned
WHATSAPP_ADMIN_BOOKING_TEMPLATE_LANGUAGE=en

NEXUS_TUNNEL_MODE=quick
NEXUS_TUNNEL_ENABLED=true
# Windows defaults (applied by run_dev.py when unset): protocol=http2, edge IPv4.
# Override only if you know you need QUIC or IPv6:
# NEXUS_TUNNEL_PROTOCOL=http2
# NEXUS_TUNNEL_EDGE_IP_VERSION=4
# Updated automatically by run_dev.py when the quick tunnel URL appears.
PUBLIC_TUNNEL_BASE=

# Environment identity (development → test number; staging/nexus-dev → business number)
NEXUS_INSTANCE=development
ENVIRONMENT=development
NEXUS_APPOINTMENTS_ONLY=true
# When true, local start claims the shared Meta webhook and hands it back to
# NEXUS_WHATSAPP_HANDOFF_URL on stop. Requires WEBHOOK_VERIFY_TOKEN to match
# the handoff host exactly (same value as nexus-dev). If tokens differ, start
# still succeeds but Meta auto-sync is skipped. Set false for UI-only local work.
NEXUS_WHATSAPP_AUTO_SYNC=true
NEXUS_WHATSAPP_HANDOFF_URL=https://nexus-dev.edutrust.in

NEXUS_PORT=8002
NEXUS_FRONTEND_PORT=5175
NEXUS_BIND_HOST=127.0.0.1

# IntelX scrapers: keep true for Cloudflare/JS sites; Chromium is constrained to
# 127.0.0.1. Set false if you want to skip Playwright and avoid Windows Firewall prompts.
# INTEL_SCRAPER_BROWSER_FALLBACK=true
FRONTEND_URL=http://127.0.0.1:5175

# Nexus Intel AI Assistant (local Ollama)
INTEL_AI_MODEL=ollama:llama3.1
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
INTEL_AI_TIMEOUT_SECONDS=300
INTEL_AI_CONTEXT_CHARS=10000
INTEL_AI_OLLAMA_KEEP_ALIVE=-1
# Note: send keep_alive as integer -1 (forever). String "-1" is rejected by Ollama.
INTEL_AI_OLLAMA_NUM_PREDICT=1024
INTEL_AI_OLLAMA_NUM_CTX=8192
INTEL_AI_OLLAMA_TEMPERATURE=0.1
INTEL_AI_OLLAMA_TOP_P=0.9
INTEL_AI_HISTORY_TURNS=3
INTEL_AI_GLOSSARY_TOP_K=12
INTEL_AI_ACADEMIA_TOP_K=18
# Optional OS-level: keep models permanently loaded (OLLAMA_KEEP_ALIVE=-1)

# Education taxonomy embeddings (super/major/sub name + description)
# OPENAI_API_KEY=sk-...
# EMBEDDING_PROVIDER=openai
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSIONS=1536
# Or local: ollama pull nomic-embed-text
# EMBEDDING_PROVIDER=ollama
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_EMBEDDING_DIMENSIONS=768
# TAXONOMY_EMBEDDINGS_ENABLED=true

# ScanX CRM document ingest (FINAL v1 SRS — CRM only; mobile Phase 2)
# Required operational caps (env-only; no admin UI in v1). Shown in D11 rules panel.
SCANX_MAX_FILE_SIZE_BYTES=10485760
SCANX_MAX_PAGES=10
# Object-key root inside R2_BUCKET_NAME (do not embed bucket name in the key)
SCANX_R2_KEY_ROOT=STUDENTS
# Document Requirement sample templates (object-key prefix inside R2_BUCKET_NAME)
DOCUMENT_TEMPLATE_R2_PREFIX=INSTITUTIONS/DOCUMENTS/TEMPLATES
# Generated Document Checklist PDFs (object-key prefix inside R2_BUCKET_NAME)
DOCUMENT_CHECKLIST_R2_PREFIX=INSTITUTIONS/DOCUMENTS/CHECKLIST
# RQ queue name (requires REDIS_URL + `python -m app.workers.scanx_worker`)
SCANX_WORKER_QUEUE=scanx
# Image OCR: primary engine (rapid|paddle) + fallback when primary fails/empty/unavailable
SCANX_OCR_ENGINE=rapid
SCANX_OCR_FALLBACK=paddle
# Rapid is the default primary; CPU Paddle fallback still needs 90–180s on mark sheets.
SCANX_OCR_BUDGET_SECONDS=240
# Passport dates shown as DD-MM-YYYY (also accepts ISO / OCR variants on parse)
SCANX_DATE_FORMAT=DD-MM-YYYY
# Paddle needs paddlepaddle (Python 3.9-3.13). On 3.14, Rapid runs as primary without Paddle.
# Optional marksheet subject extract via local Ollama chat (embeddings still use nomic-embed-text)
# SCANX_LLM_SUBJECTS_ENABLED=true
# SCANX_LLM_MODEL=ollama:llama3.2
# SCANX_LLM_SUBJECTS_TIMEOUT_SECONDS=45
# SCANX_LLM_SUBJECTS_MIN_HEURISTIC=2
# Post-OCR Ollama cleanup (noise / obvious misreads) after spatial sort
# SCANX_OCR_CLEANER_ENABLED=true
# SCANX_OCR_CLEANER_MODEL=ollama:llama3.2
# SCANX_OCR_CLEANER_TIMEOUT_SECONDS=30
# REDIS_URL=redis://127.0.0.1:6379/0

# Outbound SMTP — pick ONE mode (do not mix):
#   Port 465 → implicit SSL (SMTP_SSL). SMTP_USE_TLS is ignored.
#   Port 587 → plain SMTP + STARTTLS (set SMTP_USE_TLS=true).
# Optional: SMTP_USE_SSL=true|false overrides port-based auto-detect.
# SMTP_HOST=mail.example.com
# SMTP_PORT=465
# SMTP_USE_TLS=true
# SMTP_USE_SSL=
# SMTP_USER=you@example.com
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=you@example.com
# SMTP_FROM_NAME=Nexus Counselling
