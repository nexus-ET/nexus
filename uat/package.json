{
  "name": "nexus-uat",
  "private": true,
  "version": "1.0.0",
  "description": "Pre-staging User Acceptance Testing (Playwright + TypeScript) for Nexus",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:gates": "playwright test tests/07-post-deploy-gates.spec.ts",
    "test:report": "playwright show-report reports/html",
    "summary": "node scripts/print-summary.mjs",
    "smoke:staging": "node ./scripts/run-staging-smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/node": "^22.17.0",
    "dotenv": "^16.6.1",
    "typescript": "^5.9.2"
  }
}
